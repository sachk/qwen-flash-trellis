+@lru_cache(maxsize=1)
+def _software_fp8() -> bool:
+    capability = current_platform.get_device_capability()
+    return capability is not None and capability < (8, 9)
+
+
+@triton.jit
+def _decode_e4m3fn(raw):
+    """Decode E4M3FN bytes exactly without an unsupported fp8e4nv IR type."""
+    raw = raw.to(tl.uint32)
+    # Reinterpret E4M3FN as a half with bias 15, then correct its bias by 2**8.
+    # The half's subnormals also scale exactly; no special finite-value path.
+    half_bits = (((raw & 128) << 8) | ((raw & 127) << 7)).to(tl.uint16)
+    value = half_bits.to(tl.float16, bitcast=True).to(tl.float32) * 256.0
+    return tl.where((raw & 127) == 127, float("nan"), value)
 
 
